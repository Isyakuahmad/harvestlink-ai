+class LoginRateLimiter:
+    """In-memory sliding-window limiter for failed logins.
+
+    State is per process: with several workers or replicas, move this to a shared
+    store such as Redis.
+    """
+
+    def __init__(self, max_failures: int, window_seconds: int) -> None:
+        self.max_failures = max_failures
+        self.window_seconds = window_seconds
+        self._failures: dict[str, deque[float]] = defaultdict(deque)
+        self._lock = threading.Lock()
+
+    def _recent(self, key: str, now: float) -> deque[float]:
+        failures = self._failures[key]
+        while failures and now - failures[0] > self.window_seconds:
+            failures.popleft()
+        return failures
+
+    def is_blocked(self, key: str) -> bool:
+        with self._lock:
+            failures = self._recent(key, time.monotonic())
+            if not failures:
+                self._failures.pop(key, None)
+            return len(failures) >= self.max_failures
+
+    def record_failure(self, key: str) -> None:
+        with self._lock:
+            now = time.monotonic()
+            self._recent(key, now).append(now)
+
+    def reset(self, key: str | None = None) -> None:
+        with self._lock:
+            if key is None:
+                self._failures.clear()
+            else:
+                self._failures.pop(key, None)
+
+
+_settings = get_settings()
+login_limiter = LoginRateLimiter(
+    max_failures=_settings.login_max_failed_attempts,
+    window_seconds=_settings.login_lockout_seconds,
+)
